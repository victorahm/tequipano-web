.app-main__header
  h1.app-main__title Lists
  = link_to new_list_path, class: "btn btn--primary", title: "New list", aria: { label: "New list" } do
    = ui_icon :new

ul.task-list id="lists"
  - if @lists.empty?
    li.task-list__empty
      | You have no lists yet.
      = " "
      = link_to "Create your first list", new_list_path
  - @lists.each do |list|
    li.task-card id=dom_id(list)
      .task-card__body
        p.task-card__title = list.name
        .task-card__meta
          span.task-list__accent style="--accent: #{list.color}"
          span = list.position
          span ·
          span = pluralize(list.tasks.size, "task")
      .task-card__actions
        = link_to list_path(list), class: "btn btn--ghost btn--sm", title: "Show", aria: { label: "Show #{list.name}" } do
          = ui_icon :show
        = link_to edit_list_path(list), class: "btn btn--ghost btn--sm", title: "Edit", aria: { label: "Edit #{list.name}" } do
          = ui_icon :edit
        = link_to list_path(list), class: "btn btn--ghost btn--sm", title: "Delete", aria: { label: "Delete #{list.name}" }, data: { turbo_method: :delete, turbo_confirm: "Delete \"#{list.name}\"? Its tasks will be deleted too." } do
          = ui_icon :delete
