.app-main__header
  h1.app-main__title Lists
  = link_to "New list", new_list_path, class: "btn btn--primary"

ul.task-list id="lists"
  - if @lists.empty?
    li.task-list__empty
      | You have no lists yet.
      = " "
      = link_to "Create your first list", new_list_path
  - @lists.each do |list|
    li.task-card id=dom_id(list)
      .task-card__body
        p.task-card__title = list.name
        .task-card__meta
          span.task-list__accent style="--accent: #{list.color}"
          span = list.position
          span ·
          span = pluralize(list.tasks.size, "task")
      .task-card__actions
        = link_to "Show", list_path(list), class: "btn btn--ghost btn--sm"
        = link_to "Edit", edit_list_path(list), class: "btn btn--ghost btn--sm"
        = link_to "Delete", list_path(list), class: "btn btn--ghost btn--sm", data: { turbo_method: :delete, turbo_confirm: "Delete \"#{list.name}\"? Its tasks will be deleted too." }
