.app-main__header
  h1.app-main__title = @list.name
  .form__row
    = link_to edit_list_path(@list), class: "btn btn--secondary", title: "Edit", aria: { label: "Edit #{@list.name}" } do
      = ui_icon :edit
    = link_to list_path(@list), class: "btn btn--danger", title: "Delete", aria: { label: "Delete #{@list.name}" }, data: { turbo_method: :delete, turbo_confirm: "Delete \"#{@list.name}\"? Its tasks will be deleted too." } do
      = ui_icon :delete
    = link_to "Back to lists", lists_path, class: "btn btn--ghost"

section
  h2 Details
  p.task-list__title
    span.task-list__accent style="--accent: #{@list.color}"
    = @list.color
  p
    strong Position:
    = " #{@list.position}"
  p
    strong Tasks:
    = " #{pluralize(@tasks.size, "task")}"

section
  .task-list__header
    h2.task-list__title Tasks
    = link_to new_list_task_path(@list), class: "btn btn--primary btn--sm", title: "New task", aria: { label: "New task" } do
      = ui_icon :new
  = form_with model: [ @list, @new_task ], class: "form task-quick-add" do |f|
    .form__row.form__row--bottom
      .form__group
        = f.label :title, "Quick add", class: "form__label"
        = f.text_field :title, class: "form__input", placeholder: "e.g. Write the release notes", required: true
      = f.submit "Add task", class: "btn btn--primary"
  ul.task-list id="tasks"
    - if @tasks.empty?
      li.task-list__empty
        | This list has no tasks yet.
        = " "
        = link_to "Create the first task", new_list_task_path(@list)
    - @tasks.each do |task|
      = render "tasks/task", task: task
