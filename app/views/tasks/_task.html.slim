li.task-card id=dom_id(task) class=("task-card--done" if task.done?)
  = turbo_frame_tag "#{dom_id(task)}_frame" do
    .task-card__body
      p.task-card__title = task.title
      .task-card__meta
        - if local_assigns.fetch(:show_list, false)
          span.task-list__accent style="--accent: #{task.list.color}"
          = link_to task.list.name, list_path(task.list)
          span ·
        span.badge class="badge--#{task.status}" = task.status
        span ·
        span = "Position #{task.position}"
    .task-card__actions
      = link_to "Show", list_task_path(task.list, task), class: "btn btn--ghost btn--sm", data: { turbo_frame: "_top" }
      = link_to "Edit", edit_list_task_path(task.list, task), class: "btn btn--ghost btn--sm", data: { turbo_frame: "#{dom_id(task)}_frame" }
      = link_to "Delete", list_task_path(task.list, task), class: "btn btn--ghost btn--sm", data: { turbo_method: :delete, turbo_frame: "_top", turbo_confirm: "Delete \"#{task.title}\"?" }
