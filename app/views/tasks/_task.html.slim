- draggable = local_assigns.fetch(:draggable, false)
- card_data = {}
- if draggable
  - card_data["task-id"] = task.id
  - card_data["action"] = "dragstart->task-list#dragstart dragend->task-list#dragend"
  - card_data["task-list-target"] = "card"
li.task-card *{ id: dom_id(task), class: ("task-card--done" if task.done?), draggable: (draggable ? "true" : nil), data: card_data }
  - if draggable
    span.task-card__handle title="Drag to reorder" aria-hidden="true"
      = ui_icon :drag
  = turbo_frame_tag "#{dom_id(task)}_frame" do
    .task-card__body
      p.task-card__title = task.title
      .task-card__meta
        - if local_assigns.fetch(:show_list, false)
          span.task-list__accent style="--accent: #{task.list.color}"
          = link_to task.list.name, list_path(task.list)
          span ·
        span.badge class="badge--#{task.status}" = task.status
        - if task.due_date
          span ·
          span = "Due #{task.due_date.to_fs(:short)}"
    .task-card__actions
      - unless task.done?
        = button_to list_task_path(task.list, task, task: { status: :done }), method: :patch, form_class: "task-card__actions-form", class: "btn btn--ghost btn--sm", title: "Mark as done", aria: { label: "Mark #{task.title} as done" } do
          = ui_icon :done
      = link_to list_task_path(task.list, task), class: "btn btn--ghost btn--sm", title: "Show", aria: { label: "Show #{task.title}" }, data: { turbo_frame: "_top" } do
        = ui_icon :show
      = link_to edit_list_task_path(task.list, task), class: "btn btn--ghost btn--sm", title: "Edit", aria: { label: "Edit #{task.title}" }, data: { turbo_frame: "#{dom_id(task)}_frame" } do
        = ui_icon :edit
      = link_to list_task_path(task.list, task), class: "btn btn--ghost btn--sm", title: "Delete", aria: { label: "Delete #{task.title}" }, data: { turbo_method: :delete, turbo_frame: "_top", turbo_confirm: "Delete \"#{task.title}\"?" } do
        = ui_icon :delete
