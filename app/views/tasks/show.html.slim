.app-main__header
  h1.app-main__title = @task.title
  .form__row
    = link_to "Edit", edit_list_task_path(@list, @task), class: "btn btn--secondary"
    = link_to "Delete", list_task_path(@list, @task), class: "btn btn--danger", data: { turbo_method: :delete, turbo_confirm: "Delete \"#{@task.title}\"?" }
    = link_to "Back to list", list_path(@list), class: "btn btn--ghost"

section
  h2 Details
  p
    strong List:
    = " "
    = link_to @list.name, list_path(@list)
  p
    strong Status:
    = " "
    span.badge class="badge--#{@task.status}" = @task.status
  p
    strong Position:
    = " #{@task.position}"
  p
    strong Completed at:
    = " #{@task.completed_at ? @task.completed_at.to_fs(:long) : "—"}"
  - if @task.description.present?
    p
      strong Description:
    = simple_format(@task.description)
