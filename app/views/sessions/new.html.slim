.app-main__header
  h1.app-main__title Log in

= form_with url: login_path, method: :post, class: "form" do |f|
  .form__group
    = f.label :email, "Email", class: "form__label form__label--required"
    = f.email_field :email, class: "form__input", autofocus: true, placeholder: "you@example.com"
  .form__group
    = f.label :password, "Password", class: "form__label form__label--required"
    = f.password_field :password, class: "form__input"
  .form__row
    = f.submit "Log in", class: "btn btn--primary"
    = link_to "Cancel", root_path, class: "btn btn--secondary"

p
  | No account?
  = " "
  = link_to "Sign up", signup_path
